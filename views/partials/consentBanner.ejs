<div
    id="consentBanner"
    class="consentBanner"
    role="region"
    aria-label="Cookie consent"
    aria-live="polite"
    hidden
>
    <div class="consentBanner__inner">
        <p class="consentBanner__text">
            We use Google Analytics to understand how pretriq is used. No personal data is sold or shared.
            <a href="/privacy" class="consentBanner__link">Privacy Policy</a>
        </p>
        <div class="consentBanner__actions">
            <button type="button" id="consentDecline" class="btn consentBanner__btn--decline">Decline</button>
            <button type="button" id="consentAccept" class="btn btn--primary">Accept</button>
        </div>
    </div>
</div>
