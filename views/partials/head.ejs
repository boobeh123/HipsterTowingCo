<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#4caf50">

    <%_
        // A page can pass its own title, description and path, as the learn pages do:
        // include('partials/head.ejs', { pageTitle, pageDescription, pagePath }).
        // Pages that pass nothing keep the home page's. Leave the JSON-LD block below
        // exactly as it is, whitespace included: the CSP in server.js allows it by its hash.
        const metaTitle = locals.pageTitle || 'Pretriq - Submit FMCSA Pre-Trip Inspection Checklists Digitally';
        const metaDescription = locals.pageDescription || 'Streamline your FMCSA pre-trip inspections with our digital checklist system. Create, submit, and send inspection reports with ease. Stay compliant and organized.';
        const metaUrl = `https://pretriq.com${locals.pagePath || '/'}`;
    -%>
    <title><%= metaTitle %></title>
    <meta name="title"       content="<%= metaTitle %>">
    <meta name="description" content="<%= metaDescription %>">
    <meta name="author"      content="Bobby Asakawa">
    <meta name="keywords"    content="DOT, FMCSA, online pre-trip inspection checklist, digitally, compliance, trucking, transportation">
    <meta name="robots"      content="index, follow">
    <%_ if (locals.pagePath) { -%>
    <link rel="canonical" href="<%= metaUrl %>">
    <%_ } -%>

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png"  href="/imgs/favicon-32x32.png">
    <link rel="icon" type="image/webp" href="/imgs/favicon-32x32.webp">
    <!-- <link rel="apple-touch-icon" sizes="180x180" href="/imgs/apple-touch-icon.png"> -->
    <link rel="manifest" href="/site.webmanifest">

    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Preload critical CSS -->
    <link rel="preload" href="/css/style.css" as="style">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/normalize.css" type="text/css">
    <link rel="stylesheet" href="/css/style.css" type="text/css">

    <!-- Open Graph -->
    <meta property="og:type"        content="website">
    <meta property="og:url"         content="<%= metaUrl %>">
    <meta property="og:title"       content="<%= metaTitle %>">
    <meta property="og:description" content="<%= metaDescription %>">
    <meta property="og:image"       content="https://pretriq.com/imgs/ogimage.webp">

    <!-- Twitter / X -->
    <meta property="twitter:card"        content="summary_large_image">
    <meta property="twitter:url"         content="<%= metaUrl %>">
    <meta property="twitter:title"       content="<%= metaTitle %>">
    <meta property="twitter:description" content="<%= metaDescription %>">
    <meta property="twitter:image"       content="https://pretriq.com/imgs/ogimage.webp">

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Pretriq",
        "description": "Digital FMCSA pre-trip inspection checklist system for truck drivers and fleet managers",
        "url": "https://pretriq.com",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web Browser",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "author": {
            "@type": "Person",
            "name": "Bobby Asakawa"
        },
        "creator": {
            "@type": "Organization",
            "name": "Pretriq",
            "url": "https://pretriq.com"
        },
        "keywords": "FMCSA, pre-trip inspection, truck inspection, DOT compliance, digital checklist",
        "inLanguage": "en-US"
    }
    </script>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
