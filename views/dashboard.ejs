<%- include('./partials/head.ejs') %>
<%- include('./partials/header.ejs') %>

<main id="main-content" class="dashboard" tabindex="-1" aria-labelledby="dashboard-heading">
    <div class="dashboard__inner">

        <%- include('./partials/flash.ejs') %>

        <!-- Page heading -->
        <header class="dashboard__header">
            <h1 id="dashboard-heading" class="dashboard__title">Dashboard</h1>
            <p class="dashboard__subtitle">Welcome back, <strong><%= user.name %></strong></p>
        </header>

        <!-- Quick stats -->
        <section class="dashboard__stats" aria-label="Quick stats">
            <div class="statCard">
                <p class="statCard__value"><%= totalInspections %></p>
                <p class="statCard__label">Total inspections</p>
            </div>
            <div class="statCard">
                <p class="statCard__value">
                    <% if (lastInspectionDate) { %>
                        <%= new Date(lastInspectionDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    <% } else { %>
                        &mdash;
                    <% } %>
                </p>
                <p class="statCard__label">Last inspection</p>
            </div>
            <div class="statCard">
                <button
                    type="button"
                    id="startInspectionBtn"
                    class="btn btn--primary statCard__cta"
                    aria-haspopup="dialog"
                    aria-label="Start a new pretrip report"
                >
                    Start pretrip
                </button>
            </div>
        </section>

        <!-- Inspection history -->
        <section class="dashboard__history" aria-labelledby="history-heading">
            <h2 id="history-heading" class="dashboard__sectionTitle">Inspection history</h2>

            <% if (totalInspections === 0) { %>
                <div class="dashboard__empty">
                    <p class="dashboard__emptyText">No inspections saved yet.</p>
                    <p class="dashboard__emptyHint">Start a pretrip, and click <strong>Generate &amp; Save</strong> to start your history.</p>
                    <p class="dashboard__emptyHint dashboard__emptyGuides"><strong>New to DVIRs?</strong> Read <a href="/learn/dvir">How to fill out a DVIR</a> and <a href="/learn/pre-trip">How to do a pre-trip</a> first.</p>
                </div>
            <% } else { %>
                <form class="dashboard__filters" action="/dashboard" method="GET" role="search" aria-label="Filter inspection history">
                    <div class="authPage__field dashboard__filterField dashboard__filterField--wide">
                        <label for="filter-q" class="authPage__label">Truck, trailer or remarks</label>
                        <input id="filter-q" class="authPage__input" type="search" name="q" value="<%= filters.q %>" maxlength="60" autocomplete="off" />
                    </div>
                    <div class="authPage__field dashboard__filterField">
                        <label for="filter-from" class="authPage__label">From</label>
                        <input id="filter-from" class="authPage__input" type="date" name="from" value="<%= filters.from %>" />
                    </div>
                    <div class="authPage__field dashboard__filterField">
                        <label for="filter-to" class="authPage__label">To</label>
                        <input id="filter-to" class="authPage__input" type="date" name="to" value="<%= filters.to %>" />
                    </div>
                    <div class="authPage__field dashboard__filterField">
                        <label for="filter-status" class="authPage__label">Condition</label>
                        <select id="filter-status" class="authPage__input dashboard__filterSelect" name="status">
                            <option value="">All</option>
                            <option value="defects"<% if (filters.status === 'defects') { %> selected<% } %>>Defects noted</option>
                            <option value="ok"<% if (filters.status === 'ok') { %> selected<% } %>>Satisfactory</option>
                        </select>
                    </div>
                    <%# main.js fills this with the browser's time zone, so From and To mean the driver's local days %>
                    <input id="filter-tz" type="hidden" name="tz" value="<%= filters.tz === undefined ? '' : filters.tz %>" />
                    <div class="dashboard__filterActions">
                        <button type="submit" class="btn btn--primary">Filter</button>
                        <% if (filtersActive) { %>
                            <a href="/dashboard" class="btn btn--secondary">Clear</a>
                        <% } %>
                    </div>
                </form>

                <% if (filtersIgnored) { %>
                    <p class="dashboard__filterNote">Some filters weren't valid and were ignored.</p>
                <% } %>
                <% if (filtersActive || matchingInspections > 0) { %>
                    <div class="dashboard__historyTools">
                        <% if (filtersActive) { %>
                            <p class="dashboard__resultCount"><%= matchingInspections %> of <%= totalInspections %> inspections match these filters.</p>
                        <% } %>
                        <% if (matchingInspections > 0) { %>
                            <%# A plain link, not download: if the export limit is hit, the redirect shows its message here %>
                            <a href="<%= exportUrl %>" class="btn btn--secondary dashboard__exportBtn"><%= filtersActive ? 'Download these as CSV' : 'Download all as CSV' %></a>
                        <% } %>
                    </div>
                <% } %>

                <% if (inspections.length === 0) { %>
                    <div class="dashboard__empty">
                        <p class="dashboard__emptyText">No inspections match these filters.</p>
                        <p class="dashboard__emptyHint"><a href="/dashboard">Clear the filters</a> to see your whole history.</p>
                    </div>
                <% } else { %>
                    <div class="historyTable" role="region" aria-label="Inspection history" tabindex="0">
                        <table class="historyTable__table">
                            <thead>
                                <tr>
                                    <th scope="col" class="historyTable__th">Date</th>
                                    <th scope="col" class="historyTable__th">Truck / Tractor</th>
                                    <th scope="col" class="historyTable__th">Trailer</th>
                                    <th scope="col" class="historyTable__th">Condition</th>
                                    <th scope="col" class="historyTable__th">
                                        <span class="sr-only">Actions</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <% inspections.forEach((inspection) => { %>
                                    <tr class="historyTable__row">
                                        <td class="historyTable__td" data-label="Date">
                                            <%= inspection.date
                                                ? inspection.date
                                                : new Date(inspection.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                        </td>
                                        <td class="historyTable__td" data-label="Truck / Tractor"> <%= inspection.truckTractorNo %></td>
                                        <td class="historyTable__td" data-label="Trailer"> <%= inspection.trailerNo || '—' %></td>
                                        <%# A report with defects moves on as it's signed off (utils/signOff.js) %>
                                        <td class="historyTable__td" data-label="Condition">
                                            <% if (inspection.conditionSatisfactory) { %>
                                                <span class="historyTable__badge historyTable__badge--ok">Satisfactory</span>
                                            <% } else if (inspection.signOff === 'acknowledged') { %>
                                                <span class="historyTable__badge historyTable__badge--final">Acknowledged</span>
                                            <% } else if (inspection.signOff === 'certified') { %>
                                                <span class="historyTable__badge historyTable__badge--certified">Repairs certified</span>
                                            <% } else { %>
                                                <span class="historyTable__badge historyTable__badge--flag">Defects noted</span>
                                            <% } %>
                                        </td>
                                        <td class="historyTable__td historyTable__td--action">
                                            <% if (inspection.signOff === 'open' || inspection.signOff === 'certified') { %>
                                                <button
                                                    type="button"
                                                    class="btn btn--nav historyTable__signOff"
                                                    data-id="<%= inspection._id %>"
                                                    aria-haspopup="dialog"
                                                    aria-label="Sign off repairs for truck <%= inspection.truckTractorNo %>"
                                                >
                                                    Sign off repairs
                                                </button>
                                            <% } %>
                                            <button
                                                type="button"
                                                class="btn btn--nav historyTable__redownload"
                                                data-id="<%= inspection._id %>"
                                                aria-label="Re-download inspection for truck <%= inspection.truckTractorNo %>"
                                            >
                                                Download PDF
                                            </button>
                                            <form
                                                class="historyTable__deleteForm"
                                                action="/inspections/<%= inspection._id %>?_method=DELETE"
                                                method="POST"
                                            >
                                                <button
                                                    type="submit"
                                                    class="btn btn--danger historyTable__delete"
                                                    aria-label="Delete inspection for truck <%= inspection.truckTractorNo %>"
                                                >
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination: the links keep the active filters -->
                    <% if (totalPages > 1) { %>
                        <nav class="dashboard__pagination" aria-label="Inspection history pages">
                            <% if (prevUrl) { %>
                                <a href="<%= prevUrl %>" class="btn btn--nav dashboard__pageBtn" aria-label="Previous page">&#8592; Prev</a>
                            <% } %>
                            <span class="dashboard__pageIndicator">Page <%= currentPage %> of <%= totalPages %></span>
                            <% if (nextUrl) { %>
                                <a href="<%= nextUrl %>" class="btn btn--nav dashboard__pageBtn" aria-label="Next page">Next &#8594;</a>
                            <% } %>
                        </nav>
                    <% } %>
                <% } %>
            <% } %>
        </section>

    </div>
</main>

<%- include('./partials/inspectionModal.ejs') %>
<%- include('./partials/signOffDialog.ejs') %>
<%- include('./partials/footer.ejs') %>
