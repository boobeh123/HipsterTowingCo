    the "Last reviewed" date. %>
<% const truckLabels = dvirChecklist.labelsFor('truckTractor'); %>
<% const trailerLabels = dvirChecklist.labelsFor('trailer'); %>

<main id="main-content" class="legalDoc" tabindex="-1" aria-labelledby="legalDoc-title">

    <div class="legalDoc__inner">

        <!-- Sidebar TOC -->
        <aside class="legalDoc__toc" aria-label="Table of contents">
            <p class="legalDoc__tocLabel">On this page</p>
            <nav aria-label="Guide sections">
                <ul class="legalDoc__tocList legalDoc__tocList--plain">
                    <li><a href="#when" class="legalDoc__tocLink">When you need a DVIR</a></li>
                    <li><a href="#form" class="legalDoc__tocLink">Filling out the form</a></li>
                    <li><a href="#after" class="legalDoc__tocLink">After you hand it in</a></li>
