# Copy this file to config/.env and fill in the values.
# config/.env is gitignored, so it's never committed. On Railway, set these
# in the service's Variables tab instead.

# MongoDB connection string
DB_STRING=

# A long random string that signs login cookies. To make one:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port to listen on. Use 3000 locally; Railway sets its own.
PORT=

# Set to production on Railway. Leave empty locally.
NODE_ENV=

# The site's public address, used for the link in password reset emails,
# for example https://pretriq.com. Locally: http://localhost:3000
BASE_URL=

# Gmail address that sends password reset emails, and its app password
EMAILNAME=
EMAILPASSWORD=

# Cloudinary account for profile photos
CLOUD_NAME=
API_KEY=
API_SECRET=
